{
  "name": "funciones-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write src tests styles.css *.config.* package.json README.md docs .github scripts index.html",
    "format:check": "prettier --check src tests styles.css *.config.* package.json README.md docs .github scripts index.html",
    "test:offline": "npm run build:offline && playwright test -c playwright.offline.config.ts",
    "prebuild:offline": "node scripts/prepare-assets.mjs",
    "build:offline": "tsc --noEmit && vite build --outDir dist-offline && node scripts/check-budget.mjs dist-offline",
    "preview:offline": "vite preview --outDir dist-offline --port 4174",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@remotion/player": "4.0.454",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.19.0",
    "lucide-react": "^1.53.0",
    "mathlive": "^0.111.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.454",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
